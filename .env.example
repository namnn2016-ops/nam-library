# Cấu hình Clerk Authentication (Đăng nhập / Đăng ký trên Web)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Khóa API dịch vụ gửi email Resend (Bảo mật - Chạy ở Node.js Electron, không dùng tiền tố VITE_ để tránh lộ mã trên Web)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Đường dẫn bộ cài đặt Desktop Windows (Link tải file .exe từ GitHub Releases)
VITE_DOWNLOAD_EXE_URL=https://github.com/namnn2016-ops/nam-library/releases/download/v1.0.0/nam-libary-Setup-1.0.0.exe
VITE_DOWNLOAD_GDRIVE_URL=https://drive.usercontent.google.com/download?id=1EgkII5usCuSbXSUSoOSkzfm-TTdRf-Pm&export=download&authuser=0
VITE_DOWNLOAD_GITHUB_URL=https://github.com/namnn2016-ops/nam-library/releases
