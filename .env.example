# Cấu hình Clerk Authentication (Đăng nhập / Đăng ký trên Web)
# Điền Publishable Key và Secret Key lấy từ https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Mã bí mật Clerk Secret Key (Dùng cho Backend API, Vercel Serverless Function và ký xác thực Desktop)
# Lưu ý: Lấy mã bắt đầu bằng sk_test_ hoặc sk_live_ từ Clerk Dashboard
CLERK_SECRET_KEY=your_clerk_secret_key_here
VITE_CLERK_SECRET_KEY=your_clerk_secret_key_here

# Khóa API dịch vụ gửi email Resend
VITE_RESEND_API_KEY=your_resend_api_key_here
VITE_RESEND_FROM_EMAIL=onboarding@resend.dev

# Đường dẫn bộ cài đặt Desktop Windows (Link tải trực tiếp file .exe ~123MB từ GitHub Releases)
VITE_DOWNLOAD_EXE_URL=https://github.com/namnn2016-ops/nam-library/releases/download/v1.0.0/nam-libary-Setup-1.0.0.exe
VITE_DOWNLOAD_GDRIVE_URL=https://drive.google.com/file/d/1Xk0iEaP2ZKdKSYuWyeNmLsC1XQV3Ll_a/view?usp=sharing
VITE_DOWNLOAD_GITHUB_URL=https://github.com/namnn2016-ops/nam-library/releases
VITE_DOWNLOAD_PORTABLE_URL=https://drive.google.com/file/d/1Xk0iEaP2ZKdKSYuWyeNmLsC1XQV3Ll_a/view?usp=sharing
