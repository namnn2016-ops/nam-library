# Cấu hình Clerk Authentication (Đăng nhập / Đăng ký trên Web)
# Điền Publishable Key lấy từ https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Khóa API dịch vụ gửi email Resend
VITE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
VITE_RESEND_FROM_EMAIL=onboarding@resend.dev

# Đường dẫn bộ cài đặt Desktop Windows
VITE_DOWNLOAD_EXE_URL=/downloads/nam-libary-Setup-1.0.0.exe
VITE_DOWNLOAD_GITHUB_URL=https://github.com/namnn2016-ops/nam-library/releases
VITE_DOWNLOAD_GDRIVE_URL=https://drive.google.com/file/d/1Xk0iEaP2ZKdKSYuWyeNmLsC1XQV3Ll_a/view?usp=sharing
